# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/allohq"

# Redis
REDIS_URL="redis://localhost:6379"

# Clerk Authentication (get these from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Shopify (get these from https://partners.shopify.com)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# SHOPIFY_API_KEY is the public client ID rendered into the App Bridge meta tag.
# Never expose SHOPIFY_API_SECRET to browser code.
# 32 random bytes, base64 encoded. Generate once per environment and keep in
# the platform secret manager; rotating it requires re-encrypting stored tokens.
DATA_ENCRYPTION_KEY=
WIDGET_VISITOR_SIGNING_SECRET=
GLOBAL_EMAIL_KILL_SWITCH=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shopify development-store ID used by Joon's own landing-page signup form.
# The v3 landing resolves the newest active hosted form for this store. When
# unset, the capture renders disabled instead of failing the page.
JOON_CRM_STORE_ID=
WEBHOOK_BASE_URL=http://localhost:3001
WIDGET_ALLOWED_DEV_ORIGINS=http://localhost:3000
UNSUBSCRIBE_SIGNING_SECRET=

# AI providers (only models with configured provider credentials are available)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Outbound messaging. Delivery is disabled unless this is explicitly set.
# Use allowlist for design-partner testing; move to live only after sign-off.
MESSAGING_SEND_MODE=disabled
MESSAGING_TEST_RECIPIENTS=
RESEND_API_KEY=
EMAIL_PROVIDER=resend
AWS_SES_REGION=ap-south-1
SES_TENANT_REGION_CONFIRMED=false
SES_STANDARD_REPUTATION_POLICY=
AWS_ACCOUNT_ID=
SES_FROM_EMAIL=
SES_OPERATIONAL_FROM_EMAIL=
SES_EVENT_QUEUE_URL=
SES_EVENT_TOPIC_ARN=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
MESSAGING_SMS_PROVIDER=twilio
MESSAGING_WHATSAPP_PROVIDER=twilio
MESSAGING_RCS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Environment
NODE_ENV=development

# Optional error tracking. Leave blank to keep capture disabled. Never attach
# message bodies, auth tokens, recipient/customer data or raw request payloads.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
