# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/allohq"

# Redis
REDIS_URL="redis://localhost:6379"

# Clerk Authentication (get these from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Shopify (get these from https://partners.shopify.com)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# 32 random bytes, base64 encoded. Generate once per environment and keep in
# the platform secret manager; rotating it requires re-encrypting stored tokens.
DATA_ENCRYPTION_KEY=
WIDGET_VISITOR_SIGNING_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEBHOOK_BASE_URL=http://localhost:3001
WIDGET_ALLOWED_DEV_ORIGINS=http://localhost:3000
UNSUBSCRIBE_SIGNING_SECRET=

# AI providers (only models with configured provider credentials are available)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Outbound messaging. Delivery is disabled unless this is explicitly set.
# Use allowlist for design-partner testing; move to live only after sign-off.
MESSAGING_SEND_MODE=disabled
MESSAGING_TEST_RECIPIENTS=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
MESSAGING_SMS_PROVIDER=twilio
MESSAGING_WHATSAPP_PROVIDER=twilio
MESSAGING_RCS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Environment
NODE_ENV=development
