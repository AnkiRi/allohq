# Server
PORT=3001
NODE_ENV=development

# Database (same as packages/database)
DATABASE_URL="postgresql://postgres:password@localhost:5432/allohq"

# Clerk
CLERK_SECRET_KEY=your_clerk_secret_key

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Shopify
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
DATA_ENCRYPTION_KEY=base64_encoded_32_byte_key
WIDGET_VISITOR_SIGNING_SECRET=random_secret_with_at_least_32_bytes
GLOBAL_EMAIL_KILL_SWITCH=false
WEBHOOK_BASE_URL=http://localhost:3001
WIDGET_ALLOWED_DEV_ORIGINS=http://localhost:3000
UNSUBSCRIBE_SIGNING_SECRET=at_least_32_random_characters

# Provider webhooks and delivery safety
RESEND_WEBHOOK_SECRET=
MESSAGING_SEND_MODE=disabled
MESSAGING_TEST_RECIPIENTS=

# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
