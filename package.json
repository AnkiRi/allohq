{
  "name": "allohq",
  "private": true,
  "version": "1.0.0",
  "description": "Beautiful e-commerce marketing automation platform - competitor to Klaviyo & Omnisend",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
