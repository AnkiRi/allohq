// AlloHQ Database Schema
// E-commerce marketing automation platform

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============================================================================
// CORE MODELS
// ============================================================================

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceMembers WorkspaceMember[]

  @@map("users")
}

model Workspace {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  defaultModel String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members WorkspaceMember[]
  stores  Store[]
  emailTemplates EmailTemplate[]
  campaigns      Campaign[]
  brandProfiles  BrandProfile[]
  automations      Automation[]
  generatedContent GeneratedContent[]
  messageLogs      MessageLog[]
  generatedImages  GeneratedImage[]
  tokenUsages    TokenUsage[]
  aiChats        AiChat[]
  brandAssets    BrandAsset[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member") // admin, member, viewer
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// ============================================================================
// E-COMMERCE INTEGRATIONS
// ============================================================================

model Store {
  id          String   @id @default(cuid())
  workspaceId String
  platform    String   // shopify, woocommerce, bigcommerce
  shopDomain  String
  accessToken String   // encrypted
  isActive    Boolean  @default(true)
  installedAt DateTime @default(now())
  lastSyncAt  DateTime?

  // Shop metadata (synced from Shopify)
  storeName        String?
  storeEmail       String?
  storePhone       String?
  storeLogoUrl     String?
  storeDescription String?
  address          Json?    // { address1, address2, city, province, zip, country }
  socialLinks      Json?    // { instagram?, facebook?, twitter?, tiktok?, pinterest?, youtube? }
  currency         String?
  timezone         String?
  messagingConfig  Json?    // per-store messaging provider config (future use)
  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime? // set when merchant completes onboarding wizard
  activatedAt           DateTime? // timestamp when store activation completed
  activationLog         Json?     // JSON field for tracking activation progress

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products    Product[]
  customers   Customer[]
  orders      Order[]
  collections Collection[]
  campaigns     Campaign[]
  brandProfiles BrandProfile[]
  automations   Automation[]
  brandAssets   BrandAsset[]

  aiChats       AiChat[]
  conversations    Conversation[]
  agentActions     AgentAction[]
  agentObservations  AgentObservation[]
  retentionOutcomes  RetentionOutcome[]
  abandonedCheckouts AbandonedCheckout[]

  // Sprint 1: Customer State + Autonomy
  customerStates     CustomerState[]
  autonomyConfigs    AutonomyConfig[]
  actionQueue        ActionQueue[]
  guardrails         Guardrail[]
  customerFatigueLogs CustomerFatigueLog[]

  // Sprint 3A: Creative Engine
  brandVisualProfile   BrandVisualProfile?
  creativeAssets       CreativeAsset[]
  productRepurchaseCycles ProductRepurchaseCycle[]
  processedProductImages  ProcessedProductImage[]

  // Sprint 4: Merchant Copilot
  merchantBriefings    MerchantBriefing[]
  storeBaseline        StoreBaseline?

  // Sprint 5: Journey Orchestrator
  customerJourneys     CustomerJourney[]
  abTests              ABTest[]

  // Sprint 6: Forms + Popups
  forms                Form[]
  popups               Popup[]

  // Sprint 8: Product Recommendations
  productAffinityPairs          ProductAffinityPair[]
  customerProductRecommendations CustomerProductRecommendation[]

  // Sprint 9: Proactive Outreach
  fulfillments              Fulfillment[]
  productPriceHistory       ProductPriceHistory[]
  proactiveOutreachLogs     ProactiveOutreachLog[]

  // Sprint 10: Conversation Engine
  knowledgeArticles         KnowledgeArticle[]

  @@unique([workspaceId, shopDomain])
  @@map("stores")
}

// ============================================================================
// E-COMMERCE DATA
// ============================================================================

model Product {
  id             String   @id @default(cuid())
  storeId        String
  externalId     String   // Shopify product ID
  title          String
  description    String?
  handle         String
  vendor         String?
  productType    String?
  imageUrl       String?
  price          Float
  compareAtPrice Float?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants           ProductVariant[]
  collectionProducts CollectionProduct[]

  // Sprint 3A: Creative Engine
  repurchaseCycle     ProductRepurchaseCycle?
  processedImages     ProcessedProductImage[]

  // Sprint 8: Product Recommendations
  customerProductRecommendations CustomerProductRecommendation[]

  // Sprint 9: Proactive Outreach
  priceHistory ProductPriceHistory[]

  @@unique([storeId, externalId])
  @@map("products")
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  externalId String  // Shopify variant ID
  title      String
  sku        String?
  price      Float
  inventory  Int     @default(0)
  imageUrl   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, externalId])
  @@map("product_variants")
}

model Collection {
  id             String    @id @default(cuid())
  storeId        String
  externalId     String    // Shopify collection ID
  title          String
  handle         String
  description    String?
  imageUrl       String?
  sortOrder      String?   // e.g. "best-selling", "alpha-asc"
  collectionType String    @default("custom") // "custom" or "smart"
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  collectionProducts CollectionProduct[]

  @@unique([storeId, externalId])
  @@map("collections")
}

model CollectionProduct {
  id           String @id @default(cuid())
  collectionId String
  productId    String
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@map("collection_products")
}

model Customer {
  id            String   @id @default(cuid())
  storeId       String
  externalId    String   // Shopify customer ID
  email         String
  phone         String?
  firstName     String?
  lastName      String?
  acceptsMarketing Boolean @default(false)
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]
  rfmScore RfmScore?
  lifetimeValue CustomerLifetimeValue?
  memories         CustomerMemory[]
  conversations      Conversation[]
  retentionOutcomes  RetentionOutcome[]
  abandonedCheckouts AbandonedCheckout[]
  segmentHistory     CustomerSegmentHistory[]
  customerState      CustomerState?
  customerJourneys   CustomerJourney[]
  formSubmissions    FormSubmission[]
  customerProductRecommendations CustomerProductRecommendation[]
  proactiveOutreachLogs          ProactiveOutreachLog[]

  @@unique([storeId, externalId])
  @@index([email])
  @@map("customers")
}

model Order {
  id          String   @id @default(cuid())
  storeId     String
  customerId  String
  externalId  String   // Shopify order ID
  orderNumber String
  totalPrice  Float
  subtotal    Float
  tax         Float
  shipping    Float
  currency    String   @default("USD")
  status      String   // pending, paid, fulfilled, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  attribution  OrderAttribution?
  fulfillments Fulfillment[]

  @@unique([storeId, externalId])
  @@index([customerId])
  @@map("orders")
}

model OrderAttribution {
  id           String   @id @default(cuid())
  orderId      String   @unique
  customerId   String
  storeId      String
  messageLogId String?  // which email/sms led to this order
  campaignId   String?
  automationId String?
  channel      String   // "email" | "sms"
  revenue      Float
  attributedAt DateTime @default(now())
  touchType    String   // "click" | "open" | "direct"
  windowDays   Int      // attribution window used (7, 14, 30)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([automationId])
  @@index([storeId, attributedAt])
  @@map("order_attributions")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  title     String
  quantity  Int
  price     Float

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model AbandonedCheckout {
  id          String    @id @default(cuid())
  storeId     String
  customerId  String?
  externalId  String    // Shopify checkout token or ID
  email       String?
  phone       String?
  lineItems   Json      // array of { productId, variantId, title, quantity, price }
  totalPrice  Float     @default(0)
  currency    String    @default("USD")
  checkoutUrl String?   // Shopify recovery URL
  status      String    @default("open") // open | abandoned | recovered
  abandonedAt DateTime?
  recoveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])

  @@unique([storeId, externalId])
  @@index([storeId, status])
  @@index([customerId])
  @@index([status, createdAt])
  @@map("abandoned_checkouts")
}

// ============================================================================
// CUSTOMER INTELLIGENCE (Phase 2)
// ============================================================================

model RfmScore {
  id          String   @id @default(cuid())
  customerId  String   @unique
  storeId     String
  recency     Int      // 1-5 score
  frequency   Int      // 1-5 score
  monetary    Int      // 1-5 score
  totalScore  Int      // sum of R+F+M
  segment     String   // Champions, Loyal, At Risk, Lost, etc.
  lastOrderAt DateTime?
  orderCount  Int      @default(0)
  totalSpent  Float    @default(0)
  avgOrderValue Float  @default(0)
  calculatedAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([segment])
  @@index([totalScore])
  @@map("rfm_scores")
}

model CustomerSegment {
  id          String   @id @default(cuid())
  storeId     String
  name        String   // Champions, Loyal Customers, Potential Loyalists, etc.
  slug        String
  description String?
  rfmMin      Int      @default(0)  // min total RFM score
  rfmMax      Int      @default(15) // max total RFM score
  color       String   @default("#000000")
  customerCount Int    @default(0)
  totalRevenue  Float  @default(0)
  conditions  Json?    // custom segment rules: { operator, conditions[] }
  isSystem    Boolean  @default(false) // system-generated vs custom
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]

  @@unique([storeId, slug])
  @@map("customer_segments")
}

model CustomerLifetimeValue {
  id               String   @id @default(cuid())
  customerId       String   @unique
  storeId          String
  historicalLtv    Float    @default(0) // actual spend to date
  predictedLtv     Float    @default(0) // projected future value
  avgOrderValue    Float    @default(0)
  purchaseFrequency Float   @default(0) // orders per month
  customerLifespan  Float   @default(0) // months since first order
  churnProbability  Float   @default(0) // 0-1
  lastCalculatedAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([predictedLtv])
  @@map("customer_lifetime_values")
}

model CustomerSegmentHistory {
  id          String   @id @default(cuid())
  customerId  String
  storeId     String
  fromSegment String
  toSegment   String
  changedAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, changedAt])
  @@index([storeId, changedAt])
  @@index([storeId, fromSegment])
  @@index([storeId, toSegment])
  @@map("customer_segment_history")
}

// ============================================================================
// EMAIL & CAMPAIGNS (Phase 3)
// ============================================================================

enum TemplateCategory {
  marketing
  transactional
  automation
  ai_generated
}

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
  cancelled
}


enum ContentRating {
  good
  bad
  edited
}

model EmailTemplate {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  subject     String
  previewText String?
  blocks      Json             // Array of EmailBlock objects
  html        String?          // Rendered HTML cache
  category    TemplateCategory @default(marketing)
  thumbnailUrl String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns  Campaign[]
  generatedContent GeneratedContent[]

  @@index([workspaceId])
  @@map("email_templates")
}

model Campaign {
  id             String         @id @default(cuid())
  workspaceId    String
  storeId        String
  name           String
  templateId     String?
  segmentId      String?
  status         CampaignStatus @default(draft)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int            @default(0)
  openCount      Int            @default(0)
  clickCount     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  template  EmailTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  segment   CustomerSegment? @relation(fields: [segmentId], references: [id])

  @@index([workspaceId])
  @@index([storeId])
  @@index([status])
  @@map("campaigns")
}

model BrandProfile {
  id                 String   @id @default(cuid())
  workspaceId        String
  storeId            String
  brandName          String
  brandDescription   String?
  toneAttributes     Json     // { formality, humor, energy, warmth }
  vocabulary         Json     // preferred words, phrases, CTA patterns
  visualStyle        Json     // colors, font preferences, image style
  sampleCopy         Json     // extracted examples from product descriptions
  creativeIntensity  String   @default("balanced") // "text_heavy" | "balanced" | "visual_heavy"

  // Hard params for email generation
  logoPosition     String?  @default("center") // "left" | "center" | "right"
  headerBgColor    String?  // hex color for email header background
  footerText       String?  // custom footer text / legal
  showSocialLinks  Boolean  @default(true)
  showAddress      Boolean  @default(true)

  analyzedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, storeId])
  @@map("brand_profiles")
}

model BrandAsset {
  id          String   @id @default(cuid())
  workspaceId String
  storeId     String
  type        String   // "logo" | "logo_dark" | "hero" | "lifestyle" | "icon" | "other"
  url         String
  fileName    String
  mimeType    String?
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([workspaceId, storeId, type])
  @@map("brand_assets")
}

model Automation {
  id                  String           @id @default(cuid())
  workspaceId         String
  storeId             String
  name                String
  description         String?
  category            String           // welcome_series, abandoned_cart, etc.
  status              String           @default("recommended") // recommended|generating|draft|ready|active|paused
  triggerType         String           @default("event")       // event|schedule|segment_entry|segment_exit
  triggerConfig       Json             @default("{}")
  nodes               Json             @default("[]")           // WorkflowNode[] DAG
  templateIds         String[]         @default([])
  smsTemplateIds      String[]         @default([])
  whatsappTemplateIds String[]         @default([])
  rcsTemplateIds      String[]         @default([])
  // Performance stats (incremented by resend webhook)
  sentCount           Int              @default(0)
  openCount           Int              @default(0)
  clickCount          Int              @default(0)
  bounceCount         Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([storeId])
  @@map("automations")
}

model GeneratedContent {
  id           String   @id @default(cuid())
  workspaceId  String
  templateId   String
  prompt       String
  response     String
  model        String   // e.g. gpt-4o
  intent       String   // e.g. welcome, cart_recovery, seasonal_sale
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template  EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  feedback  ContentFeedback[]

  @@index([workspaceId])
  @@index([templateId])
  @@map("generated_content")
}

model ContentFeedback {
  id                 String        @id @default(cuid())
  generatedContentId String
  rating             ContentRating
  editedContent      String?
  createdAt          DateTime      @default(now())

  generatedContent GeneratedContent @relation(fields: [generatedContentId], references: [id], onDelete: Cascade)

  @@map("content_feedback")
}

// ============================================================================
// TOKEN USAGE TRACKING
// ============================================================================

model TokenUsage {
  id           String   @id @default(cuid())
  workspaceId  String
  model        String
  inputTokens  Int
  outputTokens Int
  purpose      String   // brand_analysis, generate_email, generate_sms, generate_whatsapp, generate_rcs
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@map("token_usages")
}


// ============================================================================
// SMS TEMPLATES
// ============================================================================

model SmsTemplate {
  id           String   @id @default(cuid())
  workspaceId  String
  automationId String?
  name         String
  body         String   // message body with {{variable}} placeholders
  variables    Json     // variable definitions
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId])
  @@index([automationId])
  @@map("sms_templates")
}

// ============================================================================
// WHATSAPP TEMPLATES
// ============================================================================

model WhatsAppTemplate {
  id           String   @id @default(cuid())
  workspaceId  String
  automationId String?
  name         String
  body         String   // message body with {{1}} placeholders
  variables    Json     // variable definitions
  category     String   @default("MARKETING")
  language     String   @default("en")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId])
  @@index([automationId])
  @@map("whatsapp_templates")
}

// ============================================================================
// RCS TEMPLATES (Rich Communication Services)
// ============================================================================

model RcsTemplate {
  id           String   @id @default(cuid())
  workspaceId  String
  automationId String?
  name         String
  body         String   // rich message body
  cardTitle    String?  // rich card title
  cardImageUrl String?  // rich card image
  actions      Json     @default("[]")  // suggested actions (buttons, links)
  variables    Json     // variable definitions
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId])
  @@index([automationId])
  @@map("rcs_templates")
}

// ============================================================================
// AGENT PIPELINE
// ============================================================================

enum AgentPipelineStatus {
  pending
  running
  completed
  failed
}

enum AgentPipelinePhase {
  recommend
  generate_email
  generate_sms
  generate_whatsapp
  generate_rcs
  create_workflow
  activate
  done
}

model AgentPipelineRun {
  id            String              @id @default(cuid())
  workspaceId   String
  storeId       String
  jobId         String?             @unique
  status        AgentPipelineStatus @default(pending)
  phase         AgentPipelinePhase  @default(recommend)
  progress      Json                @default("{}")  // { message, currentProgram, etc. }
  programsCount Int                 @default(0)
  programsDone  Int                 @default(0)
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([workspaceId])
  @@index([storeId])
  @@map("agent_pipeline_runs")
}

// ============================================================================
// MESSAGE LOG (Phase 3B — Real Sending)
// ============================================================================

model MessageLog {
  id           String    @id @default(cuid())
  workspaceId  String
  storeId      String
  customerId   String?   // link to customer for attribution
  channel      String    // email|sms|whatsapp|rcs
  to           String    // email address or phone number
  subject      String?   // email only
  templateId   String?   // reference to the template used
  campaignId   String?   // if sent via campaign
  automationId String?   // if sent via automation
  externalId   String?   // provider message ID (Resend ID, Twilio SID)
  provider     String?   // twilio|gupshup|resend — which provider sent this message
  status       String    @default("queued") // queued|sent|delivered|opened|clicked|bounced|failed
  error        String?
  metadata     Json      @default("{}")
  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([campaignId])
  @@index([automationId])
  @@index([externalId])
  @@index([channel, status])
  @@index([customerId, status, createdAt])
  @@map("message_logs")
}

// ============================================================================
// GENERATED IMAGES (Phase 3C — AI Image Generation)
// ============================================================================

model GeneratedImage {
  id          String   @id @default(cuid())
  workspaceId String
  provider    String   // flux|dalle|unsplash
  prompt      String
  url         String
  purpose     String   // hero_banner|product_lifestyle|background|card
  cost        Float    @default(0)
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([prompt])
  @@map("generated_images")
}

// ============================================================================
// AI CHAT HISTORY
// ============================================================================

model AiChat {
  id          String   @id @default(cuid())
  workspaceId String
  storeId     String
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages  AiChatMessage[]

  @@index([workspaceId, updatedAt])
  @@index([storeId])
  @@map("ai_chats")
}

model AiChatMessage {
  id         String   @id @default(cuid())
  chatId     String
  role       String   // "user" | "assistant"
  content    String   @db.Text
  highlights Json?
  model      String?
  createdAt  DateTime @default(now())

  chat AiChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("ai_chat_messages")
}

// ============================================================================
// AGENT SYSTEM — Customer Brain + Conversations + Observations
// ============================================================================

model Embedding {
  id         String   @id @default(cuid())
  storeId    String
  entityType String   // product, brand, customer, faq
  entityId   String   // ID of the source entity
  chunk      String   @db.Text // text chunk that was embedded
  embedding  Unsupported("vector(1536)")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([storeId, entityType])
  @@index([entityId])
  @@map("embeddings")
}

model CustomerMemory {
  id         String   @id @default(cuid())
  storeId    String
  customerId String
  memoryType String   // preference, complaint, interaction_note, purchase_pattern
  content    String   @db.Text
  source     String   // agent, import, observation
  confidence Float    @default(1.0) // 0-1
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([customerId])
  @@index([memoryType])
  @@map("customer_memories")
}

enum ConversationStatus {
  active
  waiting    // waiting for customer response
  resolved
  escalated  // handed off to human
}

model Conversation {
  id         String             @id @default(cuid())
  storeId    String
  customerId String?
  channel    String             // widget, whatsapp, sms, email
  status     ConversationStatus @default(active)
  assignedTo String?            // user ID if handed to human
  metadata   Json               @default("{}") // session info, anonymous visitor data
  sentiment  String?            // positive, neutral, negative
  resolvedAt DateTime?
  aiBrief    String?            @db.Text // AI summary for merchant handoff
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  customer Customer?             @relation(fields: [customerId], references: [id])
  store    Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@index([storeId, status])
  @@index([customerId])
  @@map("conversations")
}

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // customer, assistant, system, tool
  content        String   @db.Text
  contentType    String   @default("text") // text, product_card, order_card, discount_card, tool_call, tool_result
  metadata       Json     @default("{}") // tool name, product data, etc.
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model AgentAction {
  id         String   @id @default(cuid())
  storeId    String
  agentType  String   // customer_assistant, retention_strategist
  actionType String   // send_message, create_discount, lookup_order, create_campaign, etc.
  input      Json     @default("{}")
  output     Json     @default("{}")
  status     String   @default("pending") // pending, running, completed, failed
  error      String?
  durationMs Int?
  createdAt  DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([agentType])
  @@map("agent_actions")
}

enum ObservationSeverity {
  info
  warning
  critical
}

model AgentObservation {
  id           String              @id @default(cuid())
  storeId      String
  type         String              // churn_spike, revenue_anomaly, campaign_underperformance, trending_product
  severity     ObservationSeverity @default(info)
  summary      String
  data         Json                @default("{}")
  acknowledged Boolean             @default(false)
  actionTaken     String?          // what the agent did in response
  suggestedAction Json?            // { type: "create_campaign"|"investigate"|..., description: "..." }
  createdAt       DateTime         @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([type, severity])
  @@map("agent_observations")
}

model RetentionOutcome {
  id               String   @id @default(cuid())
  storeId          String
  customerId       String
  interventionType String   // win_back_email, discount_offer, whatsapp_outreach, agent_conversation
  interventionId   String?  // ID of the campaign, message, or conversation
  outcome          String   // purchased, retained, reactivated, churned, no_response
  revenueImpact    Float    @default(0) // attributed revenue from this intervention
  measuredAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, measuredAt])
  @@index([customerId])
  @@index([outcome])
  @@map("retention_outcomes")
}

// ============================================================================
// CUSTOMER STATE ENGINE (Sprint 1)
// ============================================================================

model CustomerState {
  id                    String   @id @default(cuid())
  customerId            String   @unique
  storeId               String
  lifecycleStage        String   // visitor, subscriber, first_buyer, repeat, loyal, champion, at_risk, lost
  churnRisk             Float    @default(0) // 0-1 probability
  churnRiskUpdatedAt    DateTime @default(now())
  intentState           String   @default("inactive") // browsing, considering, ready_to_buy, needs_help, inactive
  channelPreference     Json     @default("{}") // { email: 0.7, whatsapp: 0.9, sms: 0.3, rcs: 0.0 }
  optimalSendWindow     Json     @default("{}") // { timezone: "Asia/Kolkata", bestHours: [10, 14, 19] }
  communicationFatigue  Json     @default("{}") // { email: { lastSent, countThisWeek }, whatsapp: {...} }
  discountSensitivity   Float    @default(0.5) // 0-1
  supportState          String   @default("clear") // clear, open_issue, recent_complaint, escalated
  trustScore            Float    @default(0.5) // 0-1
  vipLevel              String   @default("standard") // standard, silver, gold, platinum
  campaignEligibility   Json     @default("[]") // list of eligible campaign types
  lastStateUpdate       DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, lifecycleStage])
  @@index([storeId, churnRisk])
  @@index([storeId, vipLevel])
  @@map("customer_states")
}

// ============================================================================
// AUTONOMY ENGINE (Sprint 1)
// ============================================================================

model AutonomyConfig {
  id        String   @id @default(cuid())
  storeId   String
  category  String   // cart_abandonment, repurchase_reminders, win_back, post_purchase, shipping_updates, cross_sell, new_campaigns, discounts, vip_comms, segment_reassignment, support_responses, brand_voice
  tier      String   // autopilot, copilot, advisor
  settings  Json     @default("{}") // category-specific settings (e.g., { confidenceThreshold: 85 })
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, category])
  @@map("autonomy_configs")
}

model ActionQueue {
  id              String    @id @default(cuid())
  storeId         String
  type            String    // campaign, automation, outreach, alert
  status          String    @default("pending") // pending, approved, rejected, expired, auto_executed
  category        String?   // maps to AutonomyConfig category
  urgencyScore    Float     @default(50)
  confidenceScore Float     @default(50)
  expiresAt       DateTime?
  reasoning       String    // "Why I recommend this"
  estimatedRevenue Float?
  payload         Json      // action-specific data (campaign draft, automation config, etc.)
  createdAt       DateTime  @default(now())
  reviewedBy      String?   // user ID who reviewed
  reviewedAt      DateTime?
  reviewNote      String?   // optional note from reviewer
  assignedTo      String?   // team member for review

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([storeId, urgencyScore])
  @@index([status, expiresAt])
  @@map("action_queue")
}

model Guardrail {
  id        String   @id @default(cuid())
  storeId   String
  ruleType  String   // max_discount, max_sends_per_week, blocked_words, quiet_hours, spending_caps, segment_exclusions, channel_preferences, collision_avoidance, visual_guardrails
  ruleValue Json     // rule-specific configuration
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, ruleType])
  @@map("guardrails")
}

model CustomerFatigueLog {
  id           String   @id @default(cuid())
  customerId   String
  storeId      String
  channel      String   // email, sms, whatsapp, rcs
  messageType  String   // campaign, automation, proactive, support
  campaignId   String?
  automationId String?
  sentAt       DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([customerId, storeId, channel, sentAt])
  @@index([storeId, sentAt])
  @@map("customer_fatigue_logs")
}

// ============================================================================
// SPRINT 3A: CREATIVE ENGINE
// ============================================================================

model BrandVisualProfile {
  id                      String   @id @default(cuid())
  storeId                 String   @unique
  primaryColors           Json     // ["#hex1", "#hex2"]
  accentColors            Json     // ["#hex1", "#hex2"]
  fontFamily              String?  // primary heading font
  bodyFontFamily          String?  // body text font
  logoUrl                 String?
  logoVariants            Json?    // { light: url, dark: url, icon: url }
  photographyStyle        String?  // product, lifestyle, flat-lay, etc.
  visualTone              String?  // minimal, bold, warm, etc.
  layoutPreference        String?  // clean, dense, editorial, etc.
  bannedElements          Json?    // ["element1", "element2"]
  brandDesignTokens       Json?    // full token set (colors, typography, spacing, CTA, image, brand)
  aestheticClassification String?  // clean_minimal, bold_graphic, luxury_editorial, warm_organic, playful_colorful, tech_modern, heritage_artisanal, premium_dtc
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("brand_visual_profiles")
}

model CreativeAsset {
  id               String   @id @default(cuid())
  storeId          String
  type             String   // hero_banner, product_card, promo_badge, background, lifestyle, seasonal_header
  generationMethod String   // template, ai_generated, product_composite, overlay
  sourcePrompt     String?  // AI generation prompt if applicable
  templateId       String?  // MJML archetype ID if template-based
  imageUrl         String
  thumbnailUrl     String?
  width            Int?
  height           Int?
  fileSizeBytes    Int?
  format           String?  // png, jpg, webp
  channel          String?  // email, sms, whatsapp, rcs
  campaignId       String?
  metadata         Json?    // additional context (brand tokens used, overlay config, etc.)
  createdAt        DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, type])
  @@index([storeId, campaignId])
  @@map("creative_assets")
}

model ProductRepurchaseCycle {
  id             String   @id @default(cuid())
  productId      String   @unique
  storeId        String
  medianDays     Float    // median days between repurchases
  avgDays        Float    // average days between repurchases
  sampleSize     Int      // number of repeat purchases analysed
  confidence     Float    // 0-1 confidence score based on sample size
  lastCalculated DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("product_repurchase_cycles")
}

model ProcessedProductImage {
  id              String   @id @default(cuid())
  productId       String
  storeId         String
  originalUrl     String   // original Shopify image URL
  transparentUrl  String?  // background-removed version
  brandBgUrl      String?  // with brand-colored background
  sizes           Json?    // { hero: url, card: url, grid: url, thumb: url, whatsapp: url }
  overlayVariants Json?    // { discount: url, new_tag: url, price: url }
  processedAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId])
  @@index([storeId])
  @@map("processed_product_images")
}

// ============================================================================
// SPRINT 4: MERCHANT COPILOT
// ============================================================================

model MerchantBriefing {
  id           String   @id @default(cuid())
  storeId      String
  type         String   // daily, weekly, alert
  content      Json     // structured briefing content
  deliveredVia String?  // email, whatsapp, in_app
  readAt       DateTime?
  createdAt    DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, type])
  @@index([storeId, createdAt])
  @@map("merchant_briefings")
}

model StoreBaseline {
  id         String   @id @default(cuid())
  storeId    String   @unique
  capturedAt DateTime @default(now())
  metrics    Json     // snapshot of all KPIs at onboarding

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_baselines")
}

// ============================================================================
// SPRINT 5: ADAPTIVE JOURNEY ORCHESTRATOR
// ============================================================================

model CustomerJourney {
  id              String    @id @default(cuid())
  customerId      String
  storeId         String
  automationId    String?   // link to parent automation/journey definition
  journeyType     String    // welcome, winback, repurchase, post_purchase, cross_sell, re_engagement
  currentStep     Int       @default(0)
  totalSteps      Int       @default(0)
  status          String    @default("active") // active, completed, suppressed, paused, expired
  channelPath     Json      @default("[]") // ["email", "whatsapp", "sms"] — channels used so far
  stepHistory     Json      @default("[]") // [{ step, channel, sentAt, opened, clicked, converted }]
  suppressedAt    DateTime?
  suppressReason  String?   // fatigue, silence, governor, manual
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([customerId, storeId])
  @@index([storeId, status])
  @@index([storeId, journeyType])
  @@index([automationId])
  @@map("customer_journeys")
}

model ABTest {
  id           String   @id @default(cuid())
  storeId      String
  automationId String?  // optional link to automation/journey
  name         String
  variable     String   // subject_line, send_time, content, channel, template
  variantA     Json     // { value: "...", description: "..." }
  variantB     Json     // { value: "...", description: "..." }
  splitRatio   Float    @default(0.5) // 0-1, portion going to variant A
  results      Json     @default("{}") // { a: { sent, opened, clicked, converted, revenue }, b: { ... } }
  winner       String?  // "a" | "b" | null
  confidence   Float?   // statistical confidence 0-1
  status       String   @default("running") // running, concluded, cancelled
  minSampleSize Int     @default(100) // minimum sends before evaluating
  startedAt    DateTime @default(now())
  concludedAt  DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([automationId])
  @@map("ab_tests")
}

// ============================================================================
// SPRINT 6: FORMS, POPUPS + LEAD CAPTURE
// ============================================================================

model Form {
  id            String   @id @default(cuid())
  storeId       String
  name          String
  fields        Json     // FormField[] — { name, type, label, required, placeholder, options? }
  styling       Json?    // { backgroundColor, textColor, buttonColor, buttonText, borderRadius, fontFamily }
  submitAction  String   @default("subscribe") // subscribe, redirect, message
  incentiveConfig Json?  // { type: 'discount'|'freeShipping', discountType?, discountValue?, code? }
  status        String   @default("draft") // draft, active, archived
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  popups      Popup[]
  submissions FormSubmission[]

  @@index([storeId])
  @@map("forms")
}

model Popup {
  id            String   @id @default(cuid())
  storeId       String
  name          String
  formId        String
  trigger       String   // exit_intent, scroll, timer, page_load
  triggerConfig Json?    // { scrollPercent?, delayMs?, pageUrl? }
  styling       Json?    // { position, overlayColor, width, animation }
  status        String   @default("draft") // draft, active, paused, archived
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store  Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  form   Form  @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([formId])
  @@map("popups")
}

model FormSubmission {
  id           String   @id @default(cuid())
  formId       String
  customerId   String?
  data         Json     // submitted field values { email, phone, name, ... }
  source       String   @default("popup") // popup, embed, api
  consentGiven Json?    // { email?: bool, sms?: bool, whatsapp?: bool }
  capturedAt   DateTime @default(now())

  form     Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([formId])
  @@index([customerId])
  @@index([capturedAt])
  @@map("form_submissions")
}

// ============================================================================
// SPRINT 8: PRODUCT RECOMMENDATIONS
// ============================================================================

model ProductAffinityPair {
  id         String   @id @default(cuid())
  storeId    String
  productA   String
  productB   String
  coCount    Int      @default(0)
  confidence Float    @default(0)
  updatedAt  DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, productA, productB])
  @@index([storeId, productA])
  @@index([storeId, productB])
  @@map("product_affinity_pairs")
}

model CustomerProductRecommendation {
  id         String   @id @default(cuid())
  storeId    String
  customerId String
  productId  String
  score      Float
  strategy   String   // affinity, collaborative, reorder, cross_sell, trending
  reason     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([storeId, customerId])
  @@index([expiresAt])
  @@map("customer_product_recommendations")
}

// ============================================================================
// SPRINT 9: PROACTIVE OUTREACH
// ============================================================================

model Fulfillment {
  id                String    @id @default(cuid())
  storeId           String
  orderId           String
  externalId        String    // Shopify fulfillment ID
  status            String    // pending, open, success, cancelled, error, failure
  trackingCompany   String?
  trackingNumber    String?
  trackingUrl       String?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  shipmentStatus    String?   // in_transit, out_for_delivery, delivered, attempted_delivery, failure
  notifiedShipped   Boolean   @default(false)
  notifiedDelivered Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([storeId, externalId])
  @@index([orderId])
  @@index([status])
  @@map("fulfillments")
}

model ProductPriceHistory {
  id         String   @id @default(cuid())
  productId  String
  storeId    String
  oldPrice   Float
  newPrice   Float
  change     Float    // newPrice - oldPrice (negative = drop)
  recordedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([storeId, recordedAt])
  @@map("product_price_history")
}

model ProactiveOutreachLog {
  id           String   @id @default(cuid())
  storeId      String
  customerId   String
  outreachType String   // shipping_update, restock_alert, price_drop, repurchase_reminder
  referenceId  String   // fulfillmentId, productId, etc.
  channel      String
  messageLogId String?
  createdAt    DateTime @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([storeId, customerId, outreachType, referenceId])
  @@index([storeId, outreachType])
  @@map("proactive_outreach_logs")
}

// ============================================================================
// SPRINT 10: CONVERSATION ENGINE
