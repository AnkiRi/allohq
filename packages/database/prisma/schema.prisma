// AlloHQ Database Schema
// E-commerce marketing automation platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE MODELS
// ============================================================================

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceMembers WorkspaceMember[]

  @@map("users")
}

model Workspace {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  defaultModel String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members WorkspaceMember[]
  stores  Store[]
  emailTemplates EmailTemplate[]
  campaigns      Campaign[]
  brandProfiles  BrandProfile[]
  automations      Automation[]
  generatedContent GeneratedContent[]
  messageLogs      MessageLog[]
  generatedImages  GeneratedImage[]
  tokenUsages    TokenUsage[]
  aiChats        AiChat[]
  brandAssets    BrandAsset[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member") // admin, member, viewer
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// ============================================================================
// E-COMMERCE INTEGRATIONS
// ============================================================================

model Store {
  id          String   @id @default(cuid())
  workspaceId String
  platform    String   // shopify, woocommerce, bigcommerce
  shopDomain  String
  accessToken String   // encrypted
  isActive    Boolean  @default(true)
  installedAt DateTime @default(now())
  lastSyncAt  DateTime?

  // Shop metadata (synced from Shopify)
  storeName        String?
  storeEmail       String?
  storePhone       String?
  storeLogoUrl     String?
  storeDescription String?
  address          Json?    // { address1, address2, city, province, zip, country }
  socialLinks      Json?    // { instagram?, facebook?, twitter?, tiktok?, pinterest?, youtube? }
  currency         String?
  timezone         String?
  messagingConfig  Json?    // per-store messaging provider config (future use)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products  Product[]
  customers Customer[]
  orders    Order[]
  campaigns     Campaign[]
  brandProfiles BrandProfile[]
  automations   Automation[]
  brandAssets   BrandAsset[]

  aiChats       AiChat[]

  @@unique([workspaceId, shopDomain])
  @@map("stores")
}

// ============================================================================
// E-COMMERCE DATA
// ============================================================================

model Product {
  id             String   @id @default(cuid())
  storeId        String
  externalId     String   // Shopify product ID
  title          String
  description    String?
  handle         String
  vendor         String?
  productType    String?
  imageUrl       String?
  price          Float
  compareAtPrice Float?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([storeId, externalId])
  @@map("products")
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  externalId String  // Shopify variant ID
  title      String
  sku        String?
  price      Float
  inventory  Int     @default(0)
  imageUrl   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, externalId])
  @@map("product_variants")
}

model Customer {
  id            String   @id @default(cuid())
  storeId       String
  externalId    String   // Shopify customer ID
  email         String
  phone         String?
  firstName     String?
  lastName      String?
  acceptsMarketing Boolean @default(false)
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]
  rfmScore RfmScore?
  lifetimeValue CustomerLifetimeValue?

  @@unique([storeId, externalId])
  @@index([email])
  @@map("customers")
}

model Order {
  id          String   @id @default(cuid())
  storeId     String
  customerId  String
  externalId  String   // Shopify order ID
  orderNumber String
  totalPrice  Float
  subtotal    Float
  tax         Float
  shipping    Float
  currency    String   @default("USD")
  status      String   // pending, paid, fulfilled, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  attribution OrderAttribution?

  @@unique([storeId, externalId])
  @@index([customerId])
  @@map("orders")
}

model OrderAttribution {
  id           String   @id @default(cuid())
  orderId      String   @unique
  customerId   String
  storeId      String
  messageLogId String?  // which email/sms led to this order
  campaignId   String?
  automationId String?
  channel      String   // "email" | "sms"
  revenue      Float
  attributedAt DateTime @default(now())
  touchType    String   // "click" | "open" | "direct"
  windowDays   Int      // attribution window used (7, 14, 30)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([automationId])
  @@index([storeId, attributedAt])
  @@map("order_attributions")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  title     String
  quantity  Int
  price     Float

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

// ============================================================================
// CUSTOMER INTELLIGENCE (Phase 2)
// ============================================================================

model RfmScore {
  id          String   @id @default(cuid())
  customerId  String   @unique
  storeId     String
  recency     Int      // 1-5 score
  frequency   Int      // 1-5 score
  monetary    Int      // 1-5 score
  totalScore  Int      // sum of R+F+M
  segment     String   // Champions, Loyal, At Risk, Lost, etc.
  lastOrderAt DateTime?
  orderCount  Int      @default(0)
  totalSpent  Float    @default(0)
  avgOrderValue Float  @default(0)
  calculatedAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([segment])
  @@index([totalScore])
  @@map("rfm_scores")
}

model CustomerSegment {
  id          String   @id @default(cuid())
  storeId     String
  name        String   // Champions, Loyal Customers, Potential Loyalists, etc.
  slug        String
  description String?
  rfmMin      Int      @default(0)  // min total RFM score
  rfmMax      Int      @default(15) // max total RFM score
  color       String   @default("#000000")
  customerCount Int    @default(0)
  totalRevenue  Float  @default(0)
  conditions  Json?    // custom segment rules: { operator, conditions[] }
  isSystem    Boolean  @default(false) // system-generated vs custom
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]

  @@unique([storeId, slug])
  @@map("customer_segments")
}

model CustomerLifetimeValue {
  id               String   @id @default(cuid())
  customerId       String   @unique
  storeId          String
  historicalLtv    Float    @default(0) // actual spend to date
  predictedLtv     Float    @default(0) // projected future value
  avgOrderValue    Float    @default(0)
  purchaseFrequency Float   @default(0) // orders per month
  customerLifespan  Float   @default(0) // months since first order
  churnProbability  Float   @default(0) // 0-1
  lastCalculatedAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([predictedLtv])
  @@map("customer_lifetime_values")
}

// ============================================================================
// EMAIL & CAMPAIGNS (Phase 3)
// ============================================================================

enum TemplateCategory {
  marketing
  transactional
  automation
  ai_generated
}

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
  cancelled
}


enum ContentRating {
  good
  bad
  edited
}

model EmailTemplate {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  subject     String
  previewText String?
  blocks      Json             // Array of EmailBlock objects
  html        String?          // Rendered HTML cache
  category    TemplateCategory @default(marketing)
  thumbnailUrl String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns  Campaign[]
  generatedContent GeneratedContent[]

  @@index([workspaceId])
  @@map("email_templates")
}

model Campaign {
  id             String         @id @default(cuid())
  workspaceId    String
  storeId        String
  name           String
  templateId     String
  segmentId      String?
  status         CampaignStatus @default(draft)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int            @default(0)
  openCount      Int            @default(0)
  clickCount     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  template  EmailTemplate  @relation(fields: [templateId], references: [id])
  segment   CustomerSegment? @relation(fields: [segmentId], references: [id])

  @@index([workspaceId])
  @@index([storeId])
  @@index([status])
  @@map("campaigns")
}

model BrandProfile {
  id                 String   @id @default(cuid())
  workspaceId        String
  storeId            String
  brandName          String
  brandDescription   String?
  toneAttributes     Json     // { formality, humor, energy, warmth }
  vocabulary         Json     // preferred words, phrases, CTA patterns
  visualStyle        Json     // colors, font preferences, image style
  sampleCopy         Json     // extracted examples from product descriptions
  creativeIntensity  String   @default("balanced") // "text_heavy" | "balanced" | "visual_heavy"

  // Hard params for email generation
  logoPosition     String?  @default("center") // "left" | "center" | "right"
  headerBgColor    String?  // hex color for email header background
  footerText       String?  // custom footer text / legal
  showSocialLinks  Boolean  @default(true)
  showAddress      Boolean  @default(true)

  analyzedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, storeId])
  @@map("brand_profiles")
}

model BrandAsset {
  id          String   @id @default(cuid())
  workspaceId String
  storeId     String
  type        String   // "logo" | "logo_dark" | "hero" | "lifestyle" | "icon" | "other"
  url         String
  fileName    String
  mimeType    String?
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([workspaceId, storeId, type])
  @@map("brand_assets")
}

model Automation {
  id                  String           @id @default(cuid())
  workspaceId         String
  storeId             String
  name                String
  description         String?
  category            String           // welcome_series, abandoned_cart, etc.
  status              String           @default("recommended") // recommended|generating|draft|ready|active|paused
  triggerType         String           @default("event")       // event|schedule|segment_entry|segment_exit
  triggerConfig       Json             @default("{}")
  nodes               Json             @default("[]")           // WorkflowNode[] DAG
  templateIds         String[]         @default([])
  smsTemplateIds      String[]         @default([])
  whatsappTemplateIds String[]         @default([])
  rcsTemplateIds      String[]         @default([])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([storeId])
  @@map("automations")
}

model GeneratedContent {
  id           String   @id @default(cuid())
  workspaceId  String
  templateId   String
  prompt       String
  response     String
  model        String   // e.g. gpt-4o
  intent       String   // e.g. welcome, cart_recovery, seasonal_sale
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template  EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  feedback  ContentFeedback[]

  @@index([workspaceId])
  @@index([templateId])
  @@map("generated_content")
}

model ContentFeedback {
  id                 String        @id @default(cuid())
  generatedContentId String
  rating             ContentRating
  editedContent      String?
  createdAt          DateTime      @default(now())

  generatedContent GeneratedContent @relation(fields: [generatedContentId], references: [id], onDelete: Cascade)

  @@map("content_feedback")
}

// ============================================================================
// TOKEN USAGE TRACKING
// ============================================================================

model TokenUsage {
  id           String   @id @default(cuid())
  workspaceId  String
  model        String
  inputTokens  Int
  outputTokens Int
  purpose      String   // brand_analysis, generate_email, generate_sms, generate_whatsapp, generate_rcs
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@map("token_usages")
}


// ============================================================================
// SMS TEMPLATES
// ============================================================================

model SmsTemplate {
  id           String   @id @default(cuid())
  workspaceId  String
  automationId String?
  name         String
  body         String   // message body with {{variable}} placeholders
  variables    Json     // variable definitions
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId])
  @@index([automationId])
  @@map("sms_templates")
}

// ============================================================================
// WHATSAPP TEMPLATES
// ============================================================================

model WhatsAppTemplate {
  id           String   @id @default(cuid())
  workspaceId  String
  automationId String?
  name         String
  body         String   // message body with {{1}} placeholders
  variables    Json     // variable definitions
  category     String   @default("MARKETING")
  language     String   @default("en")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId])
  @@index([automationId])
  @@map("whatsapp_templates")
}

// ============================================================================
// RCS TEMPLATES (Rich Communication Services)
// ============================================================================

model RcsTemplate {
  id           String   @id @default(cuid())
  workspaceId  String
  automationId String?
  name         String
  body         String   // rich message body
  cardTitle    String?  // rich card title
  cardImageUrl String?  // rich card image
  actions      Json     @default("[]")  // suggested actions (buttons, links)
  variables    Json     // variable definitions
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId])
  @@index([automationId])
  @@map("rcs_templates")
}

// ============================================================================
// AGENT PIPELINE
// ============================================================================

enum AgentPipelineStatus {
  pending
  running
  completed
  failed
}

enum AgentPipelinePhase {
  recommend
  generate_email
  generate_sms
  generate_whatsapp
  generate_rcs
  create_workflow
  activate
  done
}

model AgentPipelineRun {
  id            String              @id @default(cuid())
  workspaceId   String
  storeId       String
  jobId         String?             @unique
  status        AgentPipelineStatus @default(pending)
  phase         AgentPipelinePhase  @default(recommend)
  progress      Json                @default("{}")  // { message, currentProgram, etc. }
  programsCount Int                 @default(0)
  programsDone  Int                 @default(0)
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([workspaceId])
  @@index([storeId])
  @@map("agent_pipeline_runs")
}

// ============================================================================
// MESSAGE LOG (Phase 3B — Real Sending)
// ============================================================================

model MessageLog {
  id           String    @id @default(cuid())
  workspaceId  String
  storeId      String
  customerId   String?   // link to customer for attribution
  channel      String    // email|sms|whatsapp|rcs
  to           String    // email address or phone number
  subject      String?   // email only
  templateId   String?   // reference to the template used
  campaignId   String?   // if sent via campaign
  automationId String?   // if sent via automation
  externalId   String?   // provider message ID (Resend ID, Twilio SID)
  provider     String?   // twilio|gupshup|resend — which provider sent this message
  status       String    @default("queued") // queued|sent|delivered|opened|clicked|bounced|failed
  error        String?
  metadata     Json      @default("{}")
  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([campaignId])
  @@index([automationId])
  @@index([externalId])
  @@index([channel, status])
  @@index([customerId, status, createdAt])
  @@map("message_logs")
}

// ============================================================================
// GENERATED IMAGES (Phase 3C — AI Image Generation)
// ============================================================================

model GeneratedImage {
  id          String   @id @default(cuid())
  workspaceId String
  provider    String   // flux|dalle|unsplash
  prompt      String
  url         String
  purpose     String   // hero_banner|product_lifestyle|background|card
  cost        Float    @default(0)
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([prompt])
  @@map("generated_images")
}

// ============================================================================
// AI CHAT HISTORY
// ============================================================================

model AiChat {
  id          String   @id @default(cuid())
  workspaceId String
  storeId     String
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages  AiChatMessage[]

  @@index([workspaceId, updatedAt])
  @@index([storeId])
  @@map("ai_chats")
}

model AiChatMessage {
  id         String   @id @default(cuid())
  chatId     String
  role       String   // "user" | "assistant"
  content    String   @db.Text
  highlights Json?
  model      String?
  createdAt  DateTime @default(now())

  chat AiChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("ai_chat_messages")
}

