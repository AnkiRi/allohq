// AlloHQ Database Schema
// E-commerce marketing automation platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE MODELS
// ============================================================================

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceMembers WorkspaceMember[]

  @@map("users")
}

model Workspace {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  defaultModel String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members WorkspaceMember[]
  stores  Store[]
  emailTemplates EmailTemplate[]
  campaigns      Campaign[]
  brandProfiles  BrandProfile[]
  emailPrograms  EmailProgram[]
  generatedContent GeneratedContent[]
  workflows      Workflow[]
  tokenUsages    TokenUsage[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member") // admin, member, viewer
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// ============================================================================
// E-COMMERCE INTEGRATIONS
// ============================================================================

model Store {
  id          String   @id @default(cuid())
  workspaceId String
  platform    String   // shopify, woocommerce, bigcommerce
  shopDomain  String
  accessToken String   // encrypted
  isActive    Boolean  @default(true)
  installedAt DateTime @default(now())
  lastSyncAt  DateTime?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products  Product[]
  customers Customer[]
  orders    Order[]
  campaigns     Campaign[]
  brandProfiles BrandProfile[]
  emailPrograms EmailProgram[]
  workflows     Workflow[]

  @@unique([workspaceId, shopDomain])
  @@map("stores")
}

// ============================================================================
// E-COMMERCE DATA
// ============================================================================

model Product {
  id             String   @id @default(cuid())
  storeId        String
  externalId     String   // Shopify product ID
  title          String
  description    String?
  handle         String
  vendor         String?
  productType    String?
  imageUrl       String?
  price          Float
  compareAtPrice Float?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([storeId, externalId])
  @@map("products")
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  externalId String  // Shopify variant ID
  title      String
  sku        String?
  price      Float
  inventory  Int     @default(0)
  imageUrl   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, externalId])
  @@map("product_variants")
}

model Customer {
  id            String   @id @default(cuid())
  storeId       String
  externalId    String   // Shopify customer ID
  email         String
  phone         String?
  firstName     String?
  lastName      String?
  acceptsMarketing Boolean @default(false)
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]
  rfmScore RfmScore?
  lifetimeValue CustomerLifetimeValue?

  @@unique([storeId, externalId])
  @@index([email])
  @@map("customers")
}

model Order {
  id          String   @id @default(cuid())
  storeId     String
  customerId  String
  externalId  String   // Shopify order ID
  orderNumber String
  totalPrice  Float
  subtotal    Float
  tax         Float
  shipping    Float
  currency    String   @default("USD")
  status      String   // pending, paid, fulfilled, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@unique([storeId, externalId])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  title     String
  quantity  Int
  price     Float

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

// ============================================================================
// CUSTOMER INTELLIGENCE (Phase 2)
// ============================================================================

model RfmScore {
  id          String   @id @default(cuid())
  customerId  String   @unique
  storeId     String
  recency     Int      // 1-5 score
  frequency   Int      // 1-5 score
  monetary    Int      // 1-5 score
  totalScore  Int      // sum of R+F+M
  segment     String   // Champions, Loyal, At Risk, Lost, etc.
  lastOrderAt DateTime?
  orderCount  Int      @default(0)
  totalSpent  Float    @default(0)
  avgOrderValue Float  @default(0)
  calculatedAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([segment])
  @@index([totalScore])
  @@map("rfm_scores")
}

model CustomerSegment {
  id          String   @id @default(cuid())
  storeId     String
  name        String   // Champions, Loyal Customers, Potential Loyalists, etc.
  slug        String
  description String?
  rfmMin      Int      @default(0)  // min total RFM score
  rfmMax      Int      @default(15) // max total RFM score
  color       String   @default("#000000")
  customerCount Int    @default(0)
  totalRevenue  Float  @default(0)
  conditions  Json?    // custom segment rules: { operator, conditions[] }
  isSystem    Boolean  @default(false) // system-generated vs custom
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]

  @@unique([storeId, slug])
  @@map("customer_segments")
}

model CustomerLifetimeValue {
  id               String   @id @default(cuid())
  customerId       String   @unique
  storeId          String
  historicalLtv    Float    @default(0) // actual spend to date
  predictedLtv     Float    @default(0) // projected future value
  avgOrderValue    Float    @default(0)
  purchaseFrequency Float   @default(0) // orders per month
  customerLifespan  Float   @default(0) // months since first order
  churnProbability  Float   @default(0) // 0-1
  lastCalculatedAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([predictedLtv])
  @@map("customer_lifetime_values")
}

// ============================================================================
// EMAIL & CAMPAIGNS (Phase 3)
// ============================================================================

enum TemplateCategory {
  marketing
  transactional
  automation
  ai_generated
}

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
  cancelled
}

enum ProgramType {
  welcome_series
  abandoned_cart
  post_purchase
  win_back
  browse_abandonment
  vip_reward
  re_engagement
  seasonal
}

enum ProgramStatus {
  recommended
  generating
  ready
  active
  paused
}

enum ContentRating {
  good
  bad
  edited
}

model EmailTemplate {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  subject     String
  previewText String?
  blocks      Json             // Array of EmailBlock objects
  html        String?          // Rendered HTML cache
  category    TemplateCategory @default(marketing)
  thumbnailUrl String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns  Campaign[]
  generatedContent GeneratedContent[]

  @@index([workspaceId])
  @@map("email_templates")
}

model Campaign {
  id             String         @id @default(cuid())
  workspaceId    String
  storeId        String
  name           String
  templateId     String
  segmentId      String?
  status         CampaignStatus @default(draft)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int            @default(0)
  openCount      Int            @default(0)
  clickCount     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  template  EmailTemplate  @relation(fields: [templateId], references: [id])
  segment   CustomerSegment? @relation(fields: [segmentId], references: [id])

  @@index([workspaceId])
  @@index([storeId])
  @@index([status])
  @@map("campaigns")
}

model BrandProfile {
  id                 String   @id @default(cuid())
  workspaceId        String
  storeId            String
  brandName          String
  brandDescription   String?
  toneAttributes     Json     // { formality, humor, energy, warmth }
  vocabulary         Json     // preferred words, phrases, CTA patterns
  visualStyle        Json     // colors, font preferences, image style
  sampleCopy         Json     // extracted examples from product descriptions
  creativeIntensity  String   @default("balanced") // "text_heavy" | "balanced" | "visual_heavy"
  analyzedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, storeId])
  @@map("brand_profiles")
}

model EmailProgram {
  id                 String        @id @default(cuid())
  workspaceId        String
  storeId            String
  programType        ProgramType
  name               String
  description        String
  status             ProgramStatus @default(recommended)
  templateIds        String[]      // FK array to generated EmailTemplates
  whatsappTemplateIds String[]     // FK array to WhatsAppTemplate records
  smsTemplateIds     String[]      // FK array to SmsTemplate records
  rcsTemplateIds     String[]      // FK array to RcsTemplate records
  triggerConfig      Json          // what triggers this program
  workflowId         String?       @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  workflow  Workflow? @relation(fields: [workflowId], references: [id])

  @@index([workspaceId])
  @@index([storeId])
  @@map("email_programs")
}

model GeneratedContent {
  id           String   @id @default(cuid())
  workspaceId  String
  templateId   String
  prompt       String
  response     String
  model        String   // e.g. gpt-4o
  intent       String   // e.g. welcome, cart_recovery, seasonal_sale
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template  EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  feedback  ContentFeedback[]

  @@index([workspaceId])
  @@index([templateId])
  @@map("generated_content")
}

model ContentFeedback {
  id                 String        @id @default(cuid())
  generatedContentId String
  rating             ContentRating
  editedContent      String?
  createdAt          DateTime      @default(now())

  generatedContent GeneratedContent @relation(fields: [generatedContentId], references: [id], onDelete: Cascade)

  @@map("content_feedback")
}

// ============================================================================
// TOKEN USAGE TRACKING
// ============================================================================

model TokenUsage {
  id           String   @id @default(cuid())
  workspaceId  String
  model        String
  inputTokens  Int
  outputTokens Int
  purpose      String   // brand_analysis, generate_email, generate_sms, generate_whatsapp, generate_rcs
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@map("token_usages")
}

// ============================================================================
// AUTOMATION WORKFLOWS
// ============================================================================

enum WorkflowStatus {
  draft
  active
  paused
  archived
}

enum TriggerType {
  event
  schedule
  segment_entry
  segment_exit
}

model Workflow {
  id          String         @id @default(cuid())
  workspaceId String
  storeId     String?
  name        String
  description String?
  status      WorkflowStatus @default(draft)
  triggerType  TriggerType
  triggerConfig Json         @default("{}")
  nodes       Json           @default("[]")  // Array of WorkflowNode objects
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store        Store?         @relation(fields: [storeId], references: [id])
  emailProgram EmailProgram?

  @@index([workspaceId])
  @@index([storeId])
  @@map("workflows")
}

// ============================================================================
// SMS TEMPLATES
// ============================================================================

model SmsTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  programId   String?
  name        String
  body        String   // message body with {{variable}} placeholders
  variables   Json     // variable definitions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([programId])
  @@map("sms_templates")
}

// ============================================================================
// WHATSAPP TEMPLATES
// ============================================================================

model WhatsAppTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  programId   String?
  name        String
  body        String   // message body with {{1}} placeholders
  variables   Json     // variable definitions
  category    String   @default("MARKETING")
  language    String   @default("en")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([programId])
  @@map("whatsapp_templates")
}

// ============================================================================
// RCS TEMPLATES (Rich Communication Services)
// ============================================================================

model RcsTemplate {
  id           String   @id @default(cuid())
  workspaceId  String
  programId    String?
  name         String
  body         String   // rich message body
  cardTitle    String?  // rich card title
  cardImageUrl String?  // rich card image
  actions      Json     @default("[]")  // suggested actions (buttons, links)
  variables    Json     // variable definitions
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId])
  @@index([programId])
  @@map("rcs_templates")
}

// ============================================================================
// AGENT PIPELINE
// ============================================================================

enum AgentPipelineStatus {
  pending
  running
  completed
  failed
}

enum AgentPipelinePhase {
  recommend
  generate_email
  generate_sms
  generate_whatsapp
  generate_rcs
  create_workflow
  activate
  done
}

model AgentPipelineRun {
  id            String              @id @default(cuid())
  workspaceId   String
  storeId       String
  jobId         String?             @unique
  status        AgentPipelineStatus @default(pending)
  phase         AgentPipelinePhase  @default(recommend)
  progress      Json                @default("{}")  // { message, currentProgram, etc. }
  programsCount Int                 @default(0)
  programsDone  Int                 @default(0)
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([workspaceId])
  @@index([storeId])
  @@map("agent_pipeline_runs")
}

