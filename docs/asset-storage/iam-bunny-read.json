{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPublishedImagesOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::joon-assets-production-632404568116-eu-north-1-an/workspaces/*",
        "arn:aws:s3:::joon-assets-production-632404568116-eu-north-1-an/stores/*"
      ]
    },
    {
      "Sid": "NeverReadRawUploads",
      "Effect": "Deny",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::joon-assets-production-632404568116-eu-north-1-an/staging/*"
    }
  ]
}
